# =====================================================================
# SketchOS 内核配置片段 (Linux 6.12, 32 位 x86)
#
# 用法: make ARCH=i386 KCONFIG_ALLCONFIG=sketchos.config allnoconfig
#   allnoconfig 会先把“能关的全部关掉”，这个文件里列出的选项再被强制打开。
#   这样得到的是一个“只包含我们需要的东西”的最小内核，每一行都有原因。
#   scripts/kernel.sh 编译后会逐行检查这些选项是否真的生效。
# =====================================================================

# ---------- 通用 ----------
CONFIG_EXPERT=y
CONFIG_LOCALVERSION="-sketchos"
CONFIG_DEFAULT_HOSTNAME="sketchos"
CONFIG_SYSVIPC=y
# 可以在系统里通过 /proc/config.gz 查看本内核的完整配置（学习用）
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
# musl 在 32 位系统上，只要时间值放得进 32 位，就优先调用老的 32 位时间系统调用
# （nanosleep、clock_nanosleep、futex 超时……）。没有这一项 sleep() 会直接失败(ENOSYS)。
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMFD_CREATE=y
# CONFIG_BASE_SMALL is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y
CONFIG_KERNEL_GZIP=y
CONFIG_SLUB=y
# 关闭模块：所有驱动都直接编进内核，initramfs 里不需要 .ko 文件
# CONFIG_MODULES is not set
# 关闭 CPU 漏洞缓解：在模拟器里只会拖慢速度
# CONFIG_CPU_MITIGATIONS is not set

# ---------- 处理器 / 平台 ----------
# 32 位 x86。v86（网页模拟器）只支持 32 位，所以内核和程序都是 i686。
# CONFIG_64BIT is not set
CONFIG_M686=y
CONFIG_NOHIGHMEM=y
# CONFIG_SMP is not set
CONFIG_X86_TSC=y
CONFIG_X86_PM_TIMER=y
# 允许 root 进程用 ioperm() 访问 I/O 端口：sketchd 用它实现“用户态鼠标驱动”
CONFIG_X86_IOPL_IOPERM=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_MAGIC_SYSRQ=y

# ---------- 可执行文件格式 ----------
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ---------- 启动 / initramfs ----------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---------- 文件系统 ----------
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_BLOCK=y
CONFIG_EXT2_FS=y

# ---------- 终端 (TTY) ----------
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_SERIAL_8250_PCI is not set
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_VGA_CONSOLE=y

# ---------- 输入设备 ----------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y

# ---------- 图形 ----------
# bochs-drm: QEMU 标准显卡 和 v86 都实现了 Bochs VBE (DISPI) 接口
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
# /dev/fb0 字符设备（fbdev 后备显示接口需要）
CONFIG_FB_DEVICE=y
# 备用：vesafb（在命令行加 vga=0x344 之类时使用）
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# ---------- 虚拟化设备 (QEMU 可选) ----------
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# ---------- 网络（只用到本机进程间通信）----------
# 图形服务器和应用之间用 Unix 域套接字通信，所以需要 CONFIG_UNIX
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y

# ---------- 声音（音乐播放器 skmusic）----------
# 声卡选的是 Sound Blaster 16：v86（网页模拟器）只模拟这一种声卡，QEMU 也能模拟（-device sb16），
# 两边用的都是 1990 年代的经典设置：I/O 端口 0x220、中断 IRQ 5、8 位 DMA 1、16 位 DMA 5。
# SB16 是插在 ISA 总线上的老式板卡，所以要先打开 ISA 总线支持（只有 32 位 x86 才有这个选项）。
CONFIG_ISA=y
# ISA 的 DMA 控制器（8237）只有 24 根地址线，只能访问物理内存最低的 16MB。
# ZONE_DMA 让内核把这 16MB 单独管理，驱动才能在里面要到声卡的 DMA 缓冲区。
CONFIG_ZONE_DMA=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_ISA=y
CONFIG_SND_SB16=y
# /proc/asound/：cat /proc/asound/cards 能看到内核认出了哪些声卡
CONFIG_SND_PROC_FS=y
# OSS 兼容层：提供 /dev/dsp。往 /dev/dsp 里 write() 的 PCM 采样就会被声卡播放出来，
# 比 ALSA 的原生接口（一堆 ioctl 和参数结构体）简单得多，适合不用任何库的教学程序。
CONFIG_SND_OSSEMUL=y
CONFIG_SND_PCM_OSS=y
# /dev/mixer：声卡上的混音器（总音量、PCM 音量……）。ALSA 驱动开机时把这些音量都设成 0（静音），
# 平常由 alsactl/amixer 这类程序调大；我们没有这些程序，由 skmusic 打开声卡时通过 /dev/mixer 调大
CONFIG_SND_MIXER_OSS=y
# 内置的内核命令行：会被放在引导程序（v86/QEMU）传来的参数前面。
# 打开了 PnP 时，SB16 驱动默认只认“即插即用”的板卡；模拟器里的 SB16 不支持 ISA PnP 协议，
# 所以告诉驱动：别用 PnP，直接按上面那组固定的端口/中断/DMA 去找。
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="snd_sb16.isapnp=0 snd_sb16.port=0x220 snd_sb16.irq=5 snd_sb16.dma8=1 snd_sb16.dma16=5"
