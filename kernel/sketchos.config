# =====================================================================
# SketchOS 内核配置片段 (Linux 6.12, 32 位 x86)
#
# 用法: make ARCH=i386 KCONFIG_ALLCONFIG=sketchos.config allnoconfig
#   allnoconfig 会先把“能关的全部关掉”，这个文件里列出的选项再被强制打开。
#   这样得到的是一个“只包含我们需要的东西”的最小内核，每一行都有原因。
#   scripts/kernel.sh 编译后会逐行检查这些选项是否真的生效。
# =====================================================================

# ---------- 通用 ----------
CONFIG_EXPERT=y
CONFIG_LOCALVERSION="-sketchos"
CONFIG_DEFAULT_HOSTNAME="sketchos"
CONFIG_SYSVIPC=y
# 可以在系统里通过 /proc/config.gz 查看本内核的完整配置（学习用）
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
# musl 在 32 位系统上，只要时间值放得进 32 位，就优先调用老的 32 位时间系统调用
# （nanosleep、clock_nanosleep、futex 超时……）。没有这一项 sleep() 会直接失败(ENOSYS)。
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMFD_CREATE=y
# CONFIG_BASE_SMALL is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_100=y
CONFIG_KERNEL_GZIP=y
CONFIG_SLUB=y
# 关闭模块：所有驱动都直接编进内核，initramfs 里不需要 .ko 文件
# CONFIG_MODULES is not set
# 关闭 CPU 漏洞缓解：在模拟器里只会拖慢速度
# CONFIG_CPU_MITIGATIONS is not set

# ---------- 处理器 / 平台 ----------
# 32 位 x86。v86（网页模拟器）只支持 32 位，所以内核和程序都是 i686。
# CONFIG_64BIT is not set
CONFIG_M686=y
CONFIG_NOHIGHMEM=y
# CONFIG_SMP is not set
CONFIG_X86_TSC=y
CONFIG_X86_PM_TIMER=y
# 允许 root 进程用 ioperm() 访问 I/O 端口：sketchd 用它实现“用户态鼠标驱动”
CONFIG_X86_IOPL_IOPERM=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_MAGIC_SYSRQ=y

# ---------- 可执行文件格式 ----------
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ---------- 启动 / initramfs ----------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---------- 文件系统 ----------
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_BLOCK=y
CONFIG_EXT2_FS=y

# ---------- 终端 (TTY) ----------
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# CONFIG_SERIAL_8250_PCI is not set
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_VGA_CONSOLE=y

# ---------- 输入设备 ----------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y

# ---------- 图形 ----------
# bochs-drm: QEMU 标准显卡 和 v86 都实现了 Bochs VBE (DISPI) 接口
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
# /dev/fb0 字符设备（fbdev 后备显示接口需要）
CONFIG_FB_DEVICE=y
# 备用：vesafb（在命令行加 vga=0x344 之类时使用）
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# ---------- 虚拟化设备 (QEMU 可选) ----------
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# ---------- 网络（只用到本机进程间通信）----------
# 图形服务器和应用之间用 Unix 域套接字通信，所以需要 CONFIG_UNIX
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
